# Backend Environment Variables
# Copy this file to .env and update values as needed

# ============================================
# LOCAL DEVELOPMENT
# ============================================

# Server Port
PORT=3001

# CORS Origins (comma-separated)
# For local development with Vite dev server
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ============================================
# PRODUCTION DEPLOYMENT (Render + Vercel)
# ============================================

# On Render, set these environment variables:
# PORT=3001
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-branch.vercel.app

# IMPORTANT: Replace with your actual Vercel URLs
# You can add multiple Vercel URLs (production + preview deployments)
# Example:
# CORS_ORIGIN=https://escrowstocks.vercel.app,https://escrowstocks-preview.vercel.app
